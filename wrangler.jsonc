{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mygov",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // One identical file on both branches (no merge conflicts).
  // Production: `wrangler deploy` → mygov worker → malaysia-at-a-glance.com.
  // Staging: `wrangler deploy --env staging` → mygov-staging worker →
  // mygov.faizalmzain.com. Cloudflare git integration build commands:
  //   mygov worker (main branch):  wrangler deploy
  //   mygov-staging worker (dev branch): wrangler deploy --env staging
  "routes": [
    { "pattern": "malaysia-at-a-glance.com", "custom_domain": true },
    { "pattern": "www.malaysia-at-a-glance.com", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "name": "mygov-staging",
      "routes": [
        { "pattern": "mygov.faizalmzain.com", "custom_domain": true }
      ],
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": false,
          "persist": true,
          "head_sampling_rate": 1
        }
      },
      "kv_namespaces": [
        { "binding": "MYGOV_DATA", "id": "40812fc5fedb4e1fb66d70f75e707f90" }
      ],
      // Environments do not inherit top-level bindings, so this is repeated
      // rather than shared. Same namespace_id is fine - counters are scoped
      // per Worker, and staging is a different Worker (mygov-staging).
      "ratelimits": [
        {
          "name": "API_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "secrets": {
        "required": ["FIDS_API_KEY"]
      }
    }
  },
  // Declaring routes turns workers.dev off by default; keep it as a fallback
  // URL for testing so a DNS or certificate issue never leaves the app dark.
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first and handles /api/*; anything else falls through
    // to a static file, and unknown paths return the SPA shell. run_worker_first
    // is required: without it the asset router serves existing files directly
    // and the Worker's KV + SEO-splice branches never run.
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  // Collector data (slow/health/radar JSON + SEO snapshot + feed) lives in KV
  // so GitHub Action collectors write data without committing to git - no more
  // bot-commit races with manual pushes. Static copies remain in public/ as a
  // cold-start fallback; the Worker prefers KV and falls back to ASSETS.
  "kv_namespaces": [
    { "binding": "MYGOV_DATA", "id": "40812fc5fedb4e1fb66d70f75e707f90" }
  ],
  // Abuse cap on /api/* (see guard() in src/index.js), keyed on client IP +
  // path. 120/min per path is far above what the dashboard itself asks for -
  // the busiest poller is the live-bus map at roughly one call per 25 s - but
  // low enough that a scripted loop stops being free. Best-effort and
  // per-colo by design; the parameter allowlists are what actually bound
  // upstream load, and this is the backstop for the routes (/api/geocode,
  // /api/reverse) whose inputs cannot be enumerated.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // FIDS upstream key. Public - it ships in malaysiaairports.com.my's own JS
  // bundle - so the point here is not confidentiality, it is that rotation has
  // to actually work. As a `vars` entry it did not: `wrangler deploy` deletes
  // every var and re-sets whatever the config holds, so a key rotated in the
  // dashboard was silently reverted to the committed one on the next deploy.
  //
  // It is a secret now (`wrangler secret put FIDS_API_KEY`), which deploys
  // never delete, so the dashboard is the source of truth and rotation sticks.
  // Declaring it here does not reveal it - `secrets.required` is a list of
  // NAMES. It makes `wrangler deploy` fail with a clear message if the secret
  // is missing, instead of shipping a Worker whose flight board 401s.
  //
  // Local dev reads it from .dev.vars (gitignored).
  "secrets": {
    "required": ["FIDS_API_KEY"]
  }
}
