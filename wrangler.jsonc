{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mygov-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // Attaching the custom domain here makes wrangler create/maintain the DNS
  // record and certificate on deploy, so it is reproducible from the repo.
  // Staging (this branch) serves the dev URL; production (main branch)
  // serves malaysia-at-a-glance.com.
  "routes": [
    { "pattern": "mygov.faizalmzain.com", "custom_domain": true }
  ],
  // Declaring routes turns workers.dev off by default; keep it as a fallback
  // URL for testing so a DNS or certificate issue never leaves the app dark.
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first and handles /api/*; anything else falls through
    // to a static file, and unknown paths return the SPA shell. run_worker_first
    // is required: without it the asset router serves existing files directly
    // and the Worker's KV + SEO-splice branches never run.
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // Collector data (slow/health/radar JSON + SEO snapshot + feed) lives in KV
  // so GitHub Action collectors write data without committing to git - no more
  // bot-commit races with manual pushes. Static copies remain in public/ as a
  // cold-start fallback; the Worker prefers KV and falls back to ASSETS.
  "kv_namespaces": [
    { "binding": "MYGOV_DATA", "id": "40812fc5fedb4e1fb66d70f75e707f90" }
  ],
  // Public API key embedded in malaysiaairports.com.my's JS bundle; declared
  // as a var (not a secret) so `wrangler deploy` pushes it — set at:
  // https://dash.cloudflare.com/.../workers/services/mygov/settings/variables
  "vars": {
    "FIDS_API_KEY": "f02f252a781a4db584d1ae9fce22bed1"
  }
}
