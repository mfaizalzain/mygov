{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mygov",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first and handles /api/*; anything else falls through
    // to a static file, and unknown paths return the SPA shell.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
