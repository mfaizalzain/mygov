{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mygov",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // Attaching the custom domain here makes wrangler create/maintain the DNS
  // record and certificate on deploy, so it is reproducible from the repo.
  "routes": [
    { "pattern": "mygov.faizalmzain.com", "custom_domain": true }
  ],
  // Declaring routes turns workers.dev off by default; keep it as a fallback
  // URL for testing so a DNS or certificate issue never leaves the app dark.
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first and handles /api/*; anything else falls through
    // to a static file, and unknown paths return the SPA shell.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
