# Cloudflare static-asset headers.
#
# The Worker runs first (assets.run_worker_first), but static files it falls
# through to are served by the asset router with these headers, so security
# headers belong here rather than in src/index.js.
#
# CSP notes:
# - The app's own JavaScript and CSS live in /app.js and /styles.css, so
#   script-src needs NO 'unsafe-inline' - inline scripts are refused entirely.
#   style-src keeps 'unsafe-inline' because the app sets ~200 inline
#   style= attributes (charts, skel skeletons, dynamic widths) that are
#   cheap to keep and low-risk: style injection cannot exfiltrate data or
#   run code, and everything else (scripts, frames, objects, forms) is
#   locked down. This matches the pragmatic tier used by major production
#   sites: no inline scripts, no inline event handlers, no eval.
# - Two locally-hosted vendor scripts (Chart.js, Leaflet) are SRI-pinned.
# - connect-src is deliberately minimal: api.data.gov.my for every dataset,
#   the S3 bucket the GTFS-static endpoint redirects to, Open-Meteo for
#   weather, and the Cloudflare beacon for analytics.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=(), encrypted-media=(), battery=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org https://*.basemaps.cartocdn.com; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self' https://api.data.gov.my https://*.s3.ap-southeast-1.amazonaws.com https://api.open-meteo.com; upgrade-insecure-requests

# The service worker must not be cached, or a stale one pins an old app shell.
/sw.js
  Cache-Control: no-cache, must-revalidate

/icons/*
  Cache-Control: public, max-age=31536000, immutable
